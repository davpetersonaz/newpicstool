<!-- /src/views/pictures.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'LittleManHarley Pictures' %></title>
    <link rel="stylesheet" href="/css/style.css"><!-- 'public' is served staticly in src/index.js -->
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <% if (searchQuery) { %>
            <h2><%= title %></h2>
            <% if (images.length === 0) { %>
                <p>No images found for "<%= searchQuery %>".</p>
            <% } else { %>
                <p>Found <%= images.length %> image<%= images.length !== 1 ? 's' : '' %>.</p>
            <% } %>
        <% } %>
        <div class="sort-buttons">
            <a href="<%= searchQuery ? '/search?q=' + searchQuery + '&sort=chrono' : '/pictures?sort=chrono' %>" class="sort-button <%= sort === 'chrono' ? 'active' : '' %>">Sort Chronologically</a>
            <a href="<%= searchQuery ? '/search?q=' + searchQuery + '&sort=alpha' : '/pictures?sort=alpha' %>" class="sort-button <%= sort === 'alpha' ? 'active' : '' %>">Sort Alphabetically</a>
            <a href="<%= searchQuery ? '/search?q=' + searchQuery + '&sort=random' : '/pictures?sort=random' %>" class="sort-button <%= sort === 'random' ? 'active' : '' %>">Shuffle the Order</a>
        </div>
        <div class="gallery">
            <% images.forEach(image => { %>
                <div class="gallery-item">
                    <img src="<%= image.src %>" alt="<%= image.name %>" loading="lazy" class="gallery-image">
                    <div class="filename"><%= image.name %></div>
                </div>
            <% }) %>
        </div>
        <!-- Full-screen modal -->
        <div id="fullscreen-modal" class="modal">
            <span id="close-modal" class="close">&times;</span>
            <img id="fullscreen-image" class="modal-content" alt="Full-screen image">
        </div>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/fullscreenPic.js"></script>
</body>
</html>
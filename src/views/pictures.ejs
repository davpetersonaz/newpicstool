<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LittleManHarley Pictures</title>
    <link rel="stylesheet" href="/css/style.css"><!-- 'public' is served staticly in src/index.js -->
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/header') %>
    <main>
        <div class="sort-buttons">
            <a href="/pictures?sort=chrono" class="sort-button <%= sort === 'chrono' ? 'active' : '' %>">Sort Chronologically</a>
            <a href="/pictures?sort=alpha" class="sort-button <%= sort === 'alpha' ? 'active' : '' %>">Sort Alphabetically</a>
            <a href="/pictures?sort=random" class="sort-button <%= sort === 'random' ? 'active' : '' %>">Shuffle the Order</a>
        </div>
        <div class="gallery">
            <% images.forEach(image => { %>
                <div class="gallery-item">
                    <img src="<%= image.src %>" alt="<%= image.name %>" loading="lazy">
                    <div class="filename"><%= image.name %></div>
                </div>
            <% }) %>
        </div>
    </main>
    <%- include('partials/footer') %>
</body>
</html>
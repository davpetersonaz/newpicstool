<!-- /src/views/pictures.ejs -->
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title><%= title || 'Memorial Gallery' %></title>
		<link rel="stylesheet" href="/css/style.css">
        <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
    </head>
    <body>
        <%- include('partials/header') %>
        <main>
            <% if (searchQuery) { %>
                <h2><%= title %></h2>
                <% if (allImages && allImages.length === 0) { %>
                    <p>No images found for "<%= searchQuery %>".</p>
                <% } else { %>
                	<p>Found <%= allImages ? allImages.length : images.length %> image<%= (allImages ? allImages.length : images.length) !== 1 ? 's' : '' %>.</p>
                <% } %>
            <% } %>

            <div class="sort-buttons">
                <a href="#" onclick="sortGallery('chrono'); return false;" class="sort-button <%= sort === 'chrono' ? 'active' : '' %>">Sort Chronologically</a>
                <a href="#" onclick="sortGallery('alpha'); return false;" class="sort-button <%= sort === 'alpha' ? 'active' : '' %>">Sort Alphabetically</a>
                <a href="#" onclick="sortGallery('random'); return false;" class="sort-button <%= sort === 'random' ? 'active' : '' %>">Shuffle the Order</a>
            </div>

            <div class="gallery" id="gallery-container">
                <% images.forEach(image => { %>
                	<div class="gallery-item" data-id="<%= image.id || '' %>">
		                <img src="<%= image.src || image.image %>" alt="<%= image.caption %>" loading="lazy" class="gallery-image">
		                <div class="caption" onclick="editCaption(this)" title="Click to edit">
		                    <%= image.caption || 'No caption' %>
                        </div>
		                <% if (isAdmin) { %>
                            <div class="admin-controls">
                                <label class="feature-label">
                                    <input type="checkbox" <%= image.featured ? 'checked' : '' %> 
                                        onchange="toggleFeature(this, <%= image.id %>)">
                                    Featured
                                </label>
                                <label class="feature-label">
                                    <input type="checkbox" <%= image.bestMoment ? 'checked' : '' %> 
                                        onchange="toggleBest(this, <%= image.id %>)">
                                    Best
                                </label>
                                <button class="delete-overlay" onclick="deletePhoto(this)" data-id="<%= image.id %>">
                                    🗑️
                                </button>
                            </div>
		                <% } %>
                    </div>
                <% }) %>
            </div>

		    <% if (allImages && allImages.length > images.length) { %>
		        <div class="load-more-container" style="text-align:center; margin: 60px 0 100px;">
		            <button id="load-more-btn" class="btn btn-primary" onclick="loadMorePhotos()">
		                Load More Photos (<%= allImages.length - images.length %> remaining)
		            </button>
		        </div>
		    <% } %>

            <!-- Full-screen modal -->
            <div id="fullscreen-modal" class="modal">
                <span id="close-modal" class="close">&times;</span>
                <img id="fullscreen-image" class="modal-content" alt="Full-screen image">
            </div>
        </main>

		<script id="gallery-data" type="application/json">
<%= JSON.stringify({
	allPhotos: allImages || images,
	initialCount: images.length,
	pageSize: pageSize || 30,
	isAdmin: !!isAdmin
}, null, 0) %>
		</script>

		<script>
            // Parse data safely
            let allPhotos = [];
            let displayedCount = 0;
            let pageSize = 30;
            let isAdminUser = false;

            try {
                const rawData = document.getElementById('gallery-data').textContent.trim();
                const parsed = JSON.parse(rawData);

                allPhotos = parsed.allPhotos || [];
                displayedCount = parsed.initialCount || 0;
                pageSize = parsed.pageSize || 30;
                isAdminUser = !!parsed.isAdmin;
            } catch (e) {
                console.error("Failed to parse gallery data:", e);
            }

		    // ==================== LOAD MORE ====================
		    function loadMorePhotos() {
		        const btn = document.getElementById('load-more-btn');
		        if (!btn){ return; }

		        btn.innerHTML = 'Loading...';
		        btn.disabled = true;
		        const nextBatch = allPhotos.slice(displayedCount, displayedCount + pageSize);
            	const gallery = document.getElementById('gallery-container');
	            nextBatch.forEach(image => {
					const item = document.createElement('div');
					item.className = 'gallery-item';
					item.dataset.id = image.id;
					item.innerHTML = `
						<img src="${image.src || image.image}" alt="${image.caption}" loading="lazy" class="gallery-image">
						<div class="caption" onclick="editCaption(this)" title="Click to edit">
							${image.caption || 'No caption'}
						</div>
					`;
					if (isAdminUser) {
						item.innerHTML += `
							<div class="admin-controls">
								<label class="feature-label">
									<input type="checkbox" onchange="toggleFeature(this, ${image.id})">
									Featured
								</label>
								<label class="feature-label">
									<input type="checkbox" onchange="toggleBest(this, ${image.id})">
									Best
								</label>
								<button class="delete-overlay" onclick="deletePhoto(this)" data-id="${image.id}">
									🗑️
								</button>
							</div>
						`;
					}

					gallery.appendChild(item);
				});

				displayedCount += nextBatch.length;
				if (displayedCount >= allPhotos.length) {
					btn.style.display = 'none';
				} else {
					btn.innerHTML = `Load More Photos (${allPhotos.length - displayedCount} remaining)`;
					btn.disabled = false;
				}
            }

            // Make it globally available for onclick
            window.loadMorePhotos = loadMorePhotos;

			async function sortGallery(newSort) {
				const url = new URL(window.location);
				url.searchParams.set('sort', newSort);

				try {
					const response = await fetch(url.toString(), {
						headers: { 'Accept': 'application/json' }   // Force JSON response
					});
					if (!response.ok) throw new Error('Network error');

					const data = await response.json();
					if (data.success) {
						const gallery = document.getElementById('gallery-container');
						gallery.innerHTML = '';

            			// Render the first page of results
						data.images.forEach(image => {
						    const item = document.createElement('div');
						    item.className = 'gallery-item';
						    item.dataset.id = image.id;
						    item.innerHTML = `
						        <img src="${image.src || image.image}" alt="${image.caption}" loading="lazy" class="gallery-image">
						        <div class="caption" onclick="editCaption(this)" title="Click to edit">
						            ${image.caption || 'No caption'}
						        </div>
						    `;
						    if (data.isAdmin) {
						        item.innerHTML += `
						            <div class="admin-controls">
						                <label class="feature-label"><input type="checkbox" onchange="toggleFeature(this, ${image.id})"> Featured</label>
						                <label class="feature-label"><input type="checkbox" onchange="toggleBest(this, ${image.id})"> Best</label>
						                <button class="delete-overlay" onclick="deletePhoto(this)" data-id="${image.id}">🗑️</button>
						            </div>
						        `;
						    }
						    gallery.appendChild(item);
						});

						// === RESET PAGING FOR NEW SORT ===
						allPhotos = data.allImages || data.images || [];
						displayedCount = data.images ? data.images.length : 0;

						// Update active sort button
						document.querySelectorAll('.sort-button').forEach(btn => {
						    const isRandom = newSort === 'random';
						    btn.classList.toggle('active', isRandom 
						        ? btn.textContent.toLowerCase().includes('shuffle') || btn.textContent.toLowerCase().includes('random') 
						        : btn.textContent.toLowerCase().includes(newSort));
						});

				        // Show/hide Load More button
		                const loadMoreBtn = document.getElementById('load-more-btn');
		                if (loadMoreBtn) {
		                    if (allPhotos.length > displayedCount) {
		                        loadMoreBtn.style.display = 'inline-block';
		                        loadMoreBtn.innerHTML = `Load More Photos (${allPhotos.length - displayedCount} remaining)`;
		                    } else {
		                        loadMoreBtn.style.display = 'none';
		                    }
		                }
					}
				} catch (err) {
					console.error('Sort failed:', err);
			        window.location.href = url.toString(); // fallback to full page reload
				}
			}

		    // Admin functions
		    async function editCaption(el) {
		        const currentText = el.textContent.trim();
		        const input = document.createElement('input');
		        input.type = 'text';
		        input.value = currentText;
		        input.style.width = '100%';
		        el.replaceWith(input);
		        input.focus();
		        input.select();

		        const save = async () => {
		            const newCaption = input.value.trim();
		            const item = input.closest('.gallery-item');
		            const photoId = item ? item.dataset.id : null;

		            if (photoId && newCaption !== currentText) {
		                try {
		                    await fetch(`/api/photo/${photoId}/caption`, {
		                        method: 'POST',
		                        headers: { 'Content-Type': 'application/json' },
		                        body: JSON.stringify({ caption: newCaption })
		                    });
		                } catch (e) {
		                    console.error('Failed to save caption');
		                }
		            }

		            const newCaptionDiv = document.createElement('div');
		            newCaptionDiv.className = 'caption';
		            newCaptionDiv.onclick = () => editCaption(newCaptionDiv);
		            newCaptionDiv.title = "Click to edit";
		            newCaptionDiv.textContent = newCaption || 'No caption';
		            input.replaceWith(newCaptionDiv);
		        };

		        input.addEventListener('blur', save);
		        input.addEventListener('keydown', e => {
		            if (e.key === 'Enter'){ save(); }
		            if (e.key === 'Escape'){ input.replaceWith(el); }
		        });
		    }

		    async function toggleFeature(checkbox, photoId) {
		        try {
		            const res = await fetch(`/api/photo/${photoId}/toggle`, {
		                method: 'POST',
		                headers: { 'Content-Type': 'application/json' },
		                body: JSON.stringify({ field: 'featured' })
		            });
		            const data = await res.json();
		            if (!data.success){ checkbox.checked = !checkbox.checked; }
		        } catch (e) {
		            checkbox.checked = !checkbox.checked;
		        }
		    }

		    async function toggleBest(checkbox, photoId) {
		        try {
		            const res = await fetch(`/api/photo/${photoId}/toggle`, {
		                method: 'POST',
		                headers: { 'Content-Type': 'application/json' },
		                body: JSON.stringify({ field: 'bestMoment' })
		            });
		            const data = await res.json();
		            if (!data.success){ checkbox.checked = !checkbox.checked; }
		        } catch (e) {
		            checkbox.checked = !checkbox.checked;
		        }
		    }

            async function deletePhoto(btn) {
                const photoId = btn.dataset.id;
				if (!photoId) {
					console.error('No photo ID found');
					return;
				}
				if (!confirm('Delete this photo permanently?')){ return; }
                try {
                    const res = await fetch(`/api/photo/${photoId}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        const item = btn.closest('.gallery-item');
                        if (item) {
                            item.style.transition = 'opacity 0.3s ease';
                            item.style.opacity = '0';
						    setTimeout(() => item.remove(), 300);
                        }
					} else {
						alert('Failed to delete photo: ' + (data.message || 'Unknown error'));
                    }
                } catch (e) {
					console.error('Delete request failed:', e);
					alert('Failed to delete photo. Please try again.');
                }
            }

        	// Lightbox	
            document.addEventListener('DOMContentLoaded', () => {
		        const modal = document.getElementById('fullscreen-modal');
		        const modalImg = document.getElementById('fullscreen-image');
		        const closeBtn = document.getElementById('close-modal');
		        const galleryImages = document.querySelectorAll('.gallery-image');

		        galleryImages.forEach(image => {
		            image.addEventListener('click', () => {
		                modal.style.display = 'block';
		                modalImg.src = image.src;
		                modalImg.alt = image.alt || '';
		            });
		        });

		        closeBtn.addEventListener('click', () => modal.style.display = 'none');
		        modal.addEventListener('click', (e) => {
		            if (e.target === modal){ modal.style.display = 'none'; }
                });
            });
        </script>

        <%- include('partials/footer') %>
        <%- include('partials/login-modal') %>
        <%- include('partials/login-modal-script') %>
    </body>
</html>
<!-- src/views/videos.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %></title>
	<link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body data-best-only="<%= showBestOnly ? 'true' : 'false' %>">
	<%- include('partials/header') %>

	<main class="main-container">
		<div class="section">
			<h2><%= title %></h2>

			<!-- Filter + Sorting Buttons -->
			<div class="sort-buttons">
				<a href="#" onclick="toggleBestMoments(); return false;" 
					class="sort-button <%= showBestOnly ? 'active' : '' %>" 
					id="best-filter-btn"
				>
					⭐ Best Moments
				</a>
				<a href="#" onclick="sortVideos('chrono'); return false;" 
					class="sort-button <%= sort === 'chrono' ? 'active' : '' %>">Sort Chronologically</a>
				<a href="#" onclick="sortVideos('alpha'); return false;" 
					class="sort-button <%= sort === 'alpha' ? 'active' : '' %>">Sort Alphabetically</a>
				<a href="#" onclick="sortVideos('random'); return false;" 
					class="sort-button <%= (!sort || sort === 'random') ? 'active' : '' %>">Shuffle</a>
			</div>

			<% if (videos && videos.length > 0) { %>
				<div class="video-grid" id="video-grid">
					<% videos.forEach(video => { %>
						<div class="video-card">
							<div class="video-wrapper">
								<iframe 
									src="https://www.youtube.com/embed/<%= video.youtubeId %>" 
									title="<%= video.title %>"
									frameborder="0" 
									allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
									allowfullscreen>
								</iframe>
							</div>
							<div class="video-info">
								<% if (video.description) { %>
                                    <p class="video-description">
                                        <%= video.description.substring(0, 180) %><%= video.description.length > 180 ? '...' : '' %>
                                    </p>
								<% } %>
							</div>
						</div>
					<% }) %>
				</div>
                <% if (typeof hasMore !== 'undefined' && hasMore) { %>
                    <div style="text-align: center; margin: 50px 0 30px;">
                        <button id="load-more-videos" class="btn btn-primary" onclick="loadMoreVideos()">
                            Load More Videos
                        </button>
                    </div>
                <% } %>
			<% } else { %>
				<p>No videos available yet.</p>
			<% } %>
		</div>
	</main>

    <!-- Clean config (no warnings) -->
    <script id="video-config" type="application/json">
		<%- JSON.stringify({
			hasMore: typeof hasMore !== 'undefined' ? !!hasMore : false,
			showBestOnly: !!showBestOnly,
			sort: sort || 'random',
			headerTitle: headerTitle || 'Memorial Site'
		}) %>
	</script>

	<script>
        // ===== State =====
        let currentPage = 1;
        let hasMore = false;
        let isLoading = false;
        let isBestOnly = false;
        let currentSort = 'random';
        let headerTitle = 'Memorial Site';

		try {
            const config = JSON.parse(document.getElementById('video-config').textContent);
            hasMore = config.hasMore;
            isBestOnly = config.showBestOnly;
            currentSort = config.sort;
            headerTitle = config.headerTitle;
		} catch (e) {
            console.error('Failed to parse video config', e);
		}

        // ===== Helper: render a list of videos =====
        function renderVideos(videoList, append = false) {
			const container = document.getElementById('video-grid');
            if (!append){ container.innerHTML = ''; }

			videoList.forEach(video => {
				const card = document.createElement('div');
				card.className = 'video-card';
				card.innerHTML = `
					<div class="video-wrapper">
						<iframe src="https://www.youtube.com/embed/${video.youtubeId}" 
                                title="${video.title || ''}" frameborder="0" 
								allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
								allowfullscreen></iframe>
					</div>
					<div class="video-info">
						<p class="video-description">${video.description ? video.description.substring(0, 180) + (video.description.length > 180 ? '...' : '') : ''}</p>
					</div>
				`;
				container.appendChild(card);
			});
		}

        // ===== LOAD MORE =====
        async function loadMoreVideos() {
            if (!hasMore || isLoading) return;

            const btn = document.getElementById('load-more-videos');
            if (btn) {
				btn.textContent = 'Loading...';
				btn.disabled = true;
            }
            isLoading = true;

            try {
                const url = new URL(window.location.href);
                url.searchParams.set('page', currentPage + 1);

                const res = await fetch(url.toString(), {
                    headers: { 'Accept': 'application/json' }
	            });
                const data = await res.json();

                if (data.success && data.videos?.length) {
                    renderVideos(data.videos, true); // append
                    currentPage = data.page;
                    hasMore = data.hasMore;
                    if (btn) {
                        if (!hasMore) {
							btn.style.display = 'none';
						} else {
                            btn.textContent = 'Load More Videos';
			                btn.disabled = false;
						}
					}
                }
            } catch (err) {
                console.error('Load more failed:', err);
                if (btn) {
                    btn.textContent = 'Load More Videos';
                    btn.disabled = false;
                }
            } finally {
                isLoading = false;
            }
		}

        // ===== SORT =====
		async function sortVideos(newSort) {
			currentSort = newSort;
            const url = new URL(window.location.href);
			url.searchParams.set('sort', newSort);
            url.searchParams.delete('page');
            if (isBestOnly){ url.searchParams.set('best', 'true'); }
            else{ url.searchParams.delete('best'); }

			try {
                const res = await fetch(url.toString(), {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();
				if (data.success) {
                    renderVideos(data.videos || []);
                    currentPage = 1;
                    hasMore = data.hasMore;
					updateActiveButtons();
                    updateLoadMoreButton();
				}
			} catch (err) {
				console.error(err);
				window.location.href = url.toString();
			}
		}

        // ===== BEST MOMENTS TOGGLE =====
		async function toggleBestMoments() {
			isBestOnly = !isBestOnly;
            const url = new URL(window.location.href);
            url.searchParams.delete('page');
			if (isBestOnly) {
				url.searchParams.set('best', 'true');
			} else {
				url.searchParams.delete('best');
			}
			url.searchParams.set('sort', currentSort);

			try {
                const res = await fetch(url.toString(), {
                    headers: { 'Accept': 'application/json' }
                });
                const data = await res.json();
				if (data.success) {
                    renderVideos(data.videos || []);
                    currentPage = 1;
                    hasMore = data.hasMore;
					updateActiveButtons();
					updateTitles();
                    updateLoadMoreButton();
				}
			} catch (err) {
				console.error(err);
				window.location.href = url.toString();
			}
		}

        // ===== UI helpers =====
        function updateTitles() {
            const newTitle = isBestOnly 
                ? `${headerTitle} - Video Best Moments` 
                : `${headerTitle} - Videos`;
            document.title = newTitle;
            const h2 = document.querySelector('main .section h2');
            if (h2){ h2.textContent = newTitle; }
        }

        function updateActiveButtons() {
            document.getElementById('best-filter-btn')?.classList.toggle('active', isBestOnly);
            document.querySelectorAll('.sort-button').forEach(btn => {
                const onclick = btn.getAttribute('onclick') || '';
                if (onclick.includes('chrono')){ btn.classList.toggle('active', currentSort === 'chrono'); }
                else if (onclick.includes('alpha')){ btn.classList.toggle('active', currentSort === 'alpha'); }
                else if (onclick.includes('random')){ btn.classList.toggle('active', currentSort === 'random'); }
		});
        }

        function updateLoadMoreButton() {
            const btn = document.getElementById('load-more-videos');
            if (!btn){ return; }
            btn.style.display = hasMore ? 'inline-block' : 'none';
            btn.textContent = 'Load More Videos';
            btn.disabled = false;
        }

        // Make functions global
        window.loadMoreVideos = loadMoreVideos;
        window.sortVideos = sortVideos;
        window.toggleBestMoments = toggleBestMoments;
	</script>

	<%- include('partials/footer') %>
</body>
</html>
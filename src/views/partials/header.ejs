<!-- /src/views/partials/header.ejs -->
<header class="header">
    <div class="header-container">
        <!-- Title - centered on mobile -->
		<a href="/" class="home_link"><%= headerTitle || title || 'Memorial Site' %></a>

		<!-- Desktop Navigation -->
		<nav class="nav_bar desktop-nav">
			<a href="/pictures" class="nav_button">Gallery</a>
			<a href="/best" class="nav_button">Best Moments</a>
			<a href="/videos" class="nav_button">Videos</a>
		</nav>

        <!-- Right side on desktop, full controls on mobile -->
        <div class="header-right">
			<form class="search_form" action="/search" method="GET">
				<input class="search_input" type="text" name="q" placeholder="Search photos...">
				<button class="search_button" type="submit">🔍</button>
			</form>
			<button class="hamburger" id="hamburger" aria-label="Toggle menu">☰</button>
		</div>
	</div>

    <!-- Mobile Menu -->
    <nav class="mobile-menu" id="mobile-menu">
        <a href="/pictures">Gallery</a>
        <a href="/best">Best Moments</a>
        <a href="/videos">Videos</a>
    </nav>
</header>

<!-- Google Analytics 4 -->
<% if (typeof googleAnalyticsId !== 'undefined' && googleAnalyticsId) { %>
	<script async src="https://www.googletagmanager.com/gtag/js?id=<%= googleAnalyticsId %>"></script>
	<script>
		window.dataLayer = window.dataLayer || [];
		function gtag(){dataLayer.push(arguments);}
		gtag('js', new Date());
		gtag('config', '<%= googleAnalyticsId %>');
	</script>

	<!-- Custom Event Tracking -->
	<script>
		// Track important interactions
		function trackEvent(action, label = '', value = null) {
			if (typeof gtag !== 'undefined') {
				gtag('event', action, {
					event_category: 'engagement',
					event_label: label,
					value: value
				});
			}
		}

		document.addEventListener('DOMContentLoaded', () => {
			// Track Load More buttons
			document.querySelectorAll('#load-more-btn, #load-more-videos').forEach(btn => {
				btn.addEventListener('click', () => {
					trackEvent('load_more_click', btn.id || 'unknown');
				});
			});

			// Track Best Moments toggle
			document.querySelectorAll('#best-filter-btn').forEach(btn => {
				btn.addEventListener('click', () => {
					trackEvent('best_moments_toggle');
				});
			});

			// Track Search form submissions
			const searchForm = document.querySelector('.search_form');
			if (searchForm) {
				searchForm.addEventListener('submit', () => {
					const query = searchForm.querySelector('input').value.trim();
					if (query){ trackEvent('search_performed', query); }
				});
			}

			// Track navigation clicks
			document.querySelectorAll('.nav_button, .mobile-menu a').forEach(link => {
				link.addEventListener('click', () => {
					trackEvent('navigation_click', link.textContent.trim());
				});
			});
		});

		// Scroll depth tracking
		let scrollDepth = 0;
		window.addEventListener('scroll', () => {
			const scrollPercent = Math.round((window.scrollY + window.innerHeight) / document.documentElement.scrollHeight * 100);
			if (scrollPercent > scrollDepth + 25) {
				scrollDepth = scrollPercent;
				trackEvent('scroll_depth', scrollPercent + '%');
			}
		});

		// Track photo clicks (lightboxes)
		document.querySelectorAll('.gallery-image').forEach(img => {
			img.addEventListener('click', () => {
				trackEvent('photo_view', img.alt || 'unknown');
			});
		});

		// Track video plays
		document.querySelectorAll('iframe').forEach(iframe => {
			// YouTube tracking is more complex, but you can track embed loads
			trackEvent('video_embed_loaded');
		});

	</script>	
<% } %>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const hamburger = document.getElementById('hamburger');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!hamburger || !mobileMenu) return;

        hamburger.addEventListener('click', (e) => {
            e.stopPropagation();
            mobileMenu.classList.toggle('active');
            
            // Optional: change icon to X when open
            hamburger.textContent = mobileMenu.classList.contains('active') ? '✕' : '☰';
        });

        // Close menu when clicking a link
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', () => {
                mobileMenu.classList.remove('active');
                hamburger.textContent = '☰';
            });
        });

        // Close menu when clicking outside
        document.addEventListener('click', (e) => {
            if (!hamburger.contains(e.target) && !mobileMenu.contains(e.target)) {
                mobileMenu.classList.remove('active');
                hamburger.textContent = '☰';
            }
        });
    });
</script>
<!-- /src/views/partials/footer.ejs -->
<footer class="footer">
	<!-- include auth-helper at the top to avoid race conditions on the admin/photos view -->
	<%- include('auth-helper') %>

	<p class="copyright">&copy; <%= new Date().getFullYear() %> <%= title || 'Memorial Site' %></p>
    
    <% if (isAdmin) { %>
        <div class="admin-dropdown">
            <button class="login_button admin-dropdown-btn" id="admin-menu-btn">
                Admin Menu ▼
            </button>
            <div class="admin-dropdown-content" id="admin-dropdown-content">
                <a href="/admin">📋 Dashboard</a>
                <a href="/admin/photos">🖼️ Manage Photos</a>
                <a href="/admin/videos">🎥 Manage Videos</a>
                <a href="/admin/logout" class="logout-link">🚪 Logout</a>
            </div>
        </div>
    <% } else { %>
        <button onclick="showLoginModal()" class="login_button">Admin Login</button>
    <% } %>
</footer>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('admin-menu-btn');
        const menu = document.getElementById('admin-dropdown-content');
        if (!btn || !menu) return;
        let isOpen = false;

		function toggleMenu() {
            isOpen = !isOpen;
            menu.style.display = (isOpen ? 'block' : 'none');
        }

        // Click on button to toggle
        btn.addEventListener('click', function(e) {
            e.stopPropagation();
            toggleMenu();
        });

        // Close menu when clicking anywhere outside
        document.addEventListener('click', function(e) {
            if (isOpen && !btn.contains(e.target) && !menu.contains(e.target)) {
            	menu.style.display = 'none';
                isOpen = false;
            }
        });

        // Prevent menu from closing when clicking inside it
        menu.addEventListener('click', function(e) {
            e.stopPropagation();
        });
    });
</script>

<%- include('login-modal') %>
<%- include('login-modal-script') %>

<!-- /src/views/admin/dashboard.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<title><%= title %></title>
	<link rel="stylesheet" href="/css/style.css">
	<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
	<%- include('../partials/header') %>

	<div class="admin-container">
		<h1>Admin Dashboard</h1>

		<!-- Site Config -->
		<div class="admin-card">
			<h2>Site Settings</h2>
			<% if (isFirstSetup) { %>
				<p style="color:#d9534f; font-weight:500;">
					First time setup — please choose a unique Site Slug below.
				</p>
			<% } %>

			<form method="POST" action="/admin/update">
				<!-- Site Slug -->
				<div style="margin-bottom: 20px;">
					<label class="form-label">Site Slug 
						<span style="color:#d9534f;">(required, can only be set once)</span>
					</label>
					<% if (isFirstSetup) { %>
						<input type="text" 
								name="siteSlug" 
								value="<%= config.siteSlug %>" 
								class="form-input" 
								required 
								placeholder="e.g. dino">
					<% } else { %>
						<div class="form-input" style="background:#f8f8f8; color:#555; padding:12px; border-radius:6px;">
							<%= config.siteSlug %>
						</div>
						<input type="hidden" name="siteSlug" value="<%= config.siteSlug %>">
					<% } %>
				</div>

				<!-- Pre Title -->
				<div style="margin-bottom: 20px;">
					<label class="form-label">Pre-Title Text <span style="color:#666;">(optional)</span></label>
					<input type="text" name="preTitle" value="<%= config.preTitle || '' %>" class="form-input">
				</div>

				<!-- Site Title -->
				<div style="margin-bottom: 20px;">
					<label class="form-label">Site Title</label>
					<input type="text" 
						name="title" 
						value="<%= config.title || '' %>" 
						class="form-input" 
						required>
				</div>

				<!-- Post Title -->
				<div style="margin-bottom: 20px;">
					<label class="form-label">Post-Title Text <span style="color:#666;">(optional)</span></label>
					<input type="text" name="postTitle" value="<%= config.postTitle || '' %>" class="form-input">
				</div>

				<!-- Homepage Bio -->
				<div style="margin-bottom: 20px;">
					<label class="form-label">Homepage Bio / Summary</label>
					<textarea name="bio" 
							rows="10" 
							class="form-input" 
							required><%= config.bio || '' %></textarea>
				</div>
							
				<button type="submit" class="btn btn-primary">
					<%= isFirstSetup ? 'Create Site Configuration' : 'Save Changes' %>
				</button>
			</form>
		</div>

		<div class="back-link">
			<a href="/">← Back to Homepage</a>
		</div>
	</div>

	<%- include('../partials/footer') %>
</body>
</html>
<!-- src/views/admin/videos.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
	<title><%= title %></title>
	<link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
	<%- include('../partials/header') %>

	<div class="admin-container">
		<h1>Manage Videos</h1>

		<% if (typeof message !== 'undefined' && message) { %>
			<div class="success-msg"><%= message %></div>
		<% } %>

		<!-- Playlist Import -->
		<div class="admin-card">
			<h2>Import from YouTube Playlist</h2>
			<form method="POST" action="/admin/videos/import-playlist" id="import-form">
				<div style="margin-bottom: 15px;">
					<label class="form-label">Playlist ID or URL</label>
					<input type="text" 
						name="playlistId" 
						id="playlistId"
						placeholder="e.g. PLxxxxxxxxxxxxxxxx or full playlist URL" 
						required 
						style="width: 100%; padding: 12px;">
				</div>
				<button type="submit" class="btn btn-primary" id="import-btn">Import Playlist Videos</button>
			</form>
			<p style="font-size:0.9em; color:#666; margin-top:10px;">
				Only new videos (not already in database) will be imported.
			</p>
		</div>

		<!-- Add Single Video -->
		<div class="admin-card">
			<h2>Add Single Video</h2>
			<form method="POST" action="/admin/videos/add">
				<input type="text" name="youtubeUrl" placeholder="YouTube URL or ID" required>
				<button type="submit">Add Video</button>
			</form>
		</div>

		<!-- DANGER ZONE -->
		<% if (videos && videos.length > 0) { %>
			<div class="admin-card danger-zone" 
				style="border: 2px solid #d9534f; background:#fff9f9;"
				data-video-count="<%= videos ? videos.length : 0 %>"
			>
				<h2 style="color:#d9534f;">⚠️ Danger Zone</h2>
				<button onclick="deleteAllVideos()" class="delete-all-btn">
					🗑️ Delete ALL Videos
				</button>
				<p style="color:#d9534f; font-size:0.9em; margin-top:8px;">
					This will permanently delete <strong><%= videos ? videos.length : 0 %></strong> videos.
				</p>
			</div>
		<% } %>

		<!-- Videos List -->
		<div class="admin-card">
			<h2>Existing Videos (<%= videos ? videos.length : 0 %>)</h2>
			<% if (videos && videos.length > 0) { %>
				<div class="video-grid" id="video-grid">
					<% videos.forEach(video => { %>
						<div class="video-card" data-id="<%= video.id %>">
							<div class="video-wrapper">
								<img src="<%= video.thumbnail %>" class="video-thumb" loading="lazy" alt="<%= video.title %>">
							</div>
							<div class="video-info">
								<h3><%= video.title %></h3>
								<% if (video.description) { %>
									<p class="video-description">
										<%= video.description.substring(0, 140) + (video.description.length > 140 ? '...' : '') %>
									</p>
								<% } %>
								<p><strong>Taken:</strong> <%= video.takenAt ? video.takenAt.toISOString().split('T')[0] : '—' %></p>
							</div>

							<% if (isAdmin) { %>
								<div class="admin-controls">
									<label>
										<input type="checkbox" <%= video.bestMoment ? 'checked' : '' %> 
											onchange="toggleBestMoment(<%= video.id %>, this.checked)">
										Best Moment
									</label>
									<button data-id="<%= video.id %>" class="delete-btn"
											onclick="deleteVideo(this)">Delete</button>
								</div>
							<% } %>
						</div>
					<% }) %>
				</div>

				<% if (allVideos && allVideos.length > videos.length) { %>
					<div style="text-align: center; margin: 50px 0 30px;">
						<button id="load-more-videos" class="btn btn-primary">
							Load More Videos (<%= allVideos.length - videos.length %> remaining)
						</button>
					</div>
				<% } %>
			<% } else { %>
				<p>No videos yet.</p>
			<% } %>
		</div>

	<%- include('../partials/footer') %>

	<script id="videos-data" type="application/json">
		<%= JSON.stringify({
			allVideos: allVideos || [],
			initialCount: videos ? videos.length : 0
		}) %>
	</script>

	<script>
		// ====================== VIDEO BEST MOMENT TOGGLE ======================
		async function toggleBestMoment(videoId, isChecked) {
			try {
				const response = await fetch(`/admin/videos/toggle-best/${videoId}`, {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' }
				});
            	if (handleAuthError(response)){ return; }
				const data = await response.json();
				if (!data.success) {
					alert('Failed to update Best Moment status');
					event.target.checked = !isChecked; // Revert checkbox
				}
			} catch (err) {
				console.error(err);
				alert('Error updating Best Moment');
				event.target.checked = !isChecked;
			}
		}

		// ====================== DELETE VIDEO ======================
		async function deleteVideo(btn) {
		    const videoId = btn.dataset.id;
		    const title = btn.closest('.video-card')?.querySelector('h3')?.textContent || 'this video';
		    
		    if (!confirm(`Delete "${title}" permanently?`)){ return; }
			try {
				const response = await fetch(`/admin/videos/delete/${videoId}`, { method: 'DELETE' });
            	if (handleAuthError(response)){ return; }
				if (response.ok) {
					location.reload();   // refresh to show updated list
				} else {
					alert('Failed to delete video');
				}
			} catch (err) {
				console.error(err);
				alert('Error deleting video');
			}
		}

    	// ====================== DELETE ALL VIDEOS ======================
		async function deleteAllVideos() {
			const dangerCard = document.querySelector('.danger-zone');
			const videoCount = dangerCard ? parseInt(dangerCard.dataset.videoCount) || 0 : 0;
        if (videoCount === 0){ return alert("There are no videos to delete."); }
        if (!confirm(`⚠️ WARNING: This will permanently delete ALL ${videoCount} videos.`)) return;
			try {
				const response = await fetch('/admin/videos/delete-all', { method: 'DELETE' });
            	if (handleAuthError(response)){ return; }
				if (response.ok) {
					alert(`Successfully deleted ${videoCount} videos.`);
					location.reload();
				} else {
					alert('Failed to delete videos');
				}
			} catch (err) {
				console.error(err);
				alert('Error deleting videos');
			}
		}

    	// ====================== IMPORT BUTTON ======================
    	document.getElementById('import-form')?.addEventListener('submit', function() {
			const btn = document.getElementById('import-btn');
		    if (btn) {
				btn.textContent = 'Importing... Please wait';
				btn.disabled = true;
		    }
		});

    	// ====================== LOAD MORE VIDEOS ======================
		let allVideosData = [];
		let displayedCount = 0;
    	let isAdminUser = false;
		try {
		    const data = JSON.parse(document.getElementById('videos-data').textContent);
		    allVideosData = data.allVideos || [];
		    displayedCount = data.initialCount || 0;
	        isAdminUser = !!data.isAdmin;
		} catch(e) {
	        console.error("Failed to parse videos data");
		}
		document.getElementById('load-more-videos')?.addEventListener('click', function() {
			const btn = this;
			btn.textContent = 'Loading...';
			btn.disabled = true;
			const nextBatch = allVideosData.slice(displayedCount, displayedCount + 8);
			const grid = document.getElementById('video-grid');
			nextBatch.forEach(video => {
				const card = document.createElement('div');
				card.className = 'video-card';
				card.dataset.id = video.id;

		        let adminHTML = '';
		        if (isAdminUser) {
		            adminHTML = `
		                <div class="admin-controls">
		                    <label>
		                        <input type="checkbox" ${video.bestMoment ? 'checked' : ''} 
		                               onchange="toggleBestMoment(${video.id}, this.checked)">
		                        Best Moment
		                    </label>
		                    <button data-id="${video.id}" class="delete-btn" onclick="deleteVideo(this)">Delete</button>
		                </div>`;
		        }
				card.innerHTML = `
					<div class="video-wrapper">
						<img src="${video.thumbnail}" class="video-thumb" loading="lazy" alt="${video.title}">
					</div>
					<div class="video-info">
						<h3>${video.title}</h3>
						${video.description ? `<p class="video-description">${video.description.substring(0, 140)}${video.description.length > 140 ? '...' : ''}</p>` : ''}
						<p><strong>Taken:</strong> ${video.takenAt ? video.takenAt.toISOString().split('T')[0] : '—'}</p>
					</div>
	                ${adminHTML}
				`;
				grid.appendChild(card);
			});

			displayedCount += nextBatch.length;
			if (displayedCount >= allVideosData.length) {
				btn.style.display = 'none';
			} else {
				btn.textContent = `Load More Videos (${allVideosData.length - displayedCount} remaining)`;
				btn.disabled = false;
			}
		});
	</script>
</body>
</html>
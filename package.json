{
    "type": "module",
    "name": "picstool",
    "version": "1.0.0",
    "description": "Memorial site builder for Dino, Harley, and future pets",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "build": "prisma generate",
        "postinstall": "prisma generate",
        "prisma:generate": "prisma generate",
        "prisma:push": "prisma db push",
        "prisma:studio": "prisma studio",
        "db:reset": "prisma db push --force-reset",
        "clean:images": "rm -rf public/images/* && echo '✅ Images folder cleared'",
        "clean": "npm run clean:images",
        "lint": "eslint src/**/*.js",
        "lint:fix": "eslint src/**/*.js --fix"
    },
    "keywords": [
        "memorial",
        "photo-gallery",
        "nodejs",
        "prisma"
    ],
    "author": "Dave Peterson",
    "license": "ISC",
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "@vercel/blob": "^2.4.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.4.1",
        "ejs": "^5.0.1",
        "exifreader": "^4.38.0",
        "express": "^5.2.1",
        "express-session": "^1.19.0",
        "multer": "^2.1.1",
        "node-fetch": "^3.3.2",
        "sharp": "^0.34.5"
    },
    "devDependencies": {
        "eslint": "^9.33.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.5",
        "nodemon": "^3.1.10",
        "prettier": "^3.8.2",
        "prisma": "^6.19.3"
    }
}
